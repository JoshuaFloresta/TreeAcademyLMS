# Copy to .env and fill in. Never commit .env — it is gitignored.
# See DEPLOYMENT.md for which of these are required in production.

# ---- Core ----
NODE_ENV=development
PORT=4000
# Where the React app is served from. Used for links inside emails and as the default CORS origin.
CLIENT_URL=http://localhost:5173
MONGODB_URI=
# Any long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Enables dev-only shortcuts (DevToolbar jump links, /demo/* endpoints). MUST be false in production.
DEMO_MODE=true

# ---- Extra browser origins allowed to call the API (production) ----
# Comma-separated. Needed when the frontend is hosted separately from the API.
ADDITIONAL_CLIENT_ORIGINS=
# Regex matched against the Origin header, for hosts that mint a URL per deploy.
# Vercel preview example: ^https://treeacademylms-[a-z0-9-]+\.vercel\.app$
CLIENT_ORIGIN_PATTERN=

# ---- File storage ----
# Local disk path used in development only.
PRIVATE_STORAGE_DIR=server/private-storage
# S3-compatible object storage. REQUIRED in production — the server refuses to boot without it,
# because managed hosts have ephemeral disks and would lose signed agreements on every redeploy.
# Cloudflare R2 example (S3_REGION stays "auto"):
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# OPTIONAL — CDN delivery for avatars/course banners only.
# Public read access is granted per BUCKET, never per folder, so these must point at a SECOND,
# separate bucket. Never make the main bucket above public: it stores signed enrollment agreements.
# Leave both blank (recommended) to serve images through the API's /uploads route instead.
S3_PUBLIC_BUCKET=
S3_PUBLIC_BASE_URL=

# ---- Payments (PayMongo) ----
# Use sk_test_... while developing; sk_live_... charges real money.
PAYMONGO_SECRET_KEY=
# From the PayMongo dashboard webhook you registered. Must match the SAME mode (test/live) as the
# secret key above, or webhooks will never verify and enrollments stay stuck on "awaiting payment".
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_LINK=https://paymongo.page/l/treeacademypayment
PAYMONGO_PAYMENT_METHODS=gcash,paymaya,card,qrph

# ---- Email (Resend) ----
RESEND_API_KEY=
# Must be on a domain verified in Resend. onboarding@resend.dev works but only delivers to the
# address you signed up to Resend with.
EMAIL_FROM=Tree Academy <onboarding@resend.dev>
ENROLLMENT_NOTIFICATION_TO=

# ---- Optional integrations ----
MAKE_NEWSLETTER_WEBHOOK_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_WEBHOOK_SECRET=
DOCUSIGN_TEMPLATE_ID=

# ---- Client build-time (Vite) ----
# Vite only exposes VITE_-prefixed vars to the browser. Leave blank locally to use
# http://localhost:4000; set to your API's public URL in the Vercel project settings.
VITE_API_URL=
